[Unit]
Description=Bot Meet V2 — configuração automática de reuniões AVAMEC
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/bot-meet
Environment=INCIDENTS_DB=/opt/bot-meet/data/incidents.db
ExecStart=/opt/bot-meet/.venv/bin/python main.py
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
